{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts"
  ]
}
