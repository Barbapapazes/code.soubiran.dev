+// Domain strings omit metadata that Cloudflare adds when resolving the zone.
+// Compare effective defaults, without hiding explicit zone or flag changes.
+export function normalizeCustomDomainRoutes(remote, local) {
+  const normalize = (route) => route && typeof route === "object" && route.custom_domain
+    ? { ...route, enabled: route.enabled ?? true, previews_enabled: route.previews_enabled ?? false }
+    : route;
+  const localRoutes = (local.routes ?? []).map(normalize);
+  const remoteRoutes = (remote.routes ?? []).map((route) => {
+    const normalized = normalize(route);
+    if (!normalized || typeof normalized !== "object" || !normalized.custom_domain) return normalized;
+    const matching = localRoutes.find((candidate) => candidate && typeof candidate === "object"
+      && candidate.custom_domain && candidate.pattern === normalized.pattern);
+    if (matching && matching.zone_name === undefined && matching.zone_id === undefined
+      && typeof normalized.zone_name === "string" && typeof normalized.pattern === "string"
+      && (normalized.pattern === normalized.zone_name || normalized.pattern.endsWith(`.${normalized.zone_name}`))) {
+      const { zone_name, ...withoutInferredZone } = normalized;
+      return withoutInferredZone;
+    }
+    return normalized;
+  });
+  return [{ ...remote, routes: remoteRoutes }, { ...local, routes: localRoutes }];
+}
